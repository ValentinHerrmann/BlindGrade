}

% ==============================================================================
% 7. Points Table Generation at Document End
% ==============================================================================

\AtEndDocument{%
    \vfill
    \ifthenelse{\boolean{Pkt}}{%
        \Large
        \noindent
        \N=\value{Punkte}%
        \setcounter{Notenzeile}{\value{Punkte}}%
        \stepcounter{Notenzeile}%
        \cols={}%
        \scorecols={}%
        \last={}%
        \setcounter{i}{1}%
        \loop
            \edef\tempcols{\the\cols \the\value{i}}%
            \cols=\expandafter{\tempcols}%
            \edef\tempscores{\the\scorecols \noexpand\getScore{\the\value{i}}}%
            \scorecols=\expandafter{\tempscores}%
            \ifnum\value{i}<\N
                \cols=\expandafter{\the\cols &}%
                \scorecols=\expandafter{\the\scorecols &}%
                \last=\expandafter{\the\last&}%
                \stepcounter{i}%
        \repeat
        
        \noindent\begin{tabularx}{\textwidth}{|*{\N}{C|}C|C|}\hline
            \the\cols & $\sum$ & Note\\\hline
            \the\scorecols & \formatScore{\TotalScoreG} & \\\cline{1-\theNotenzeile}
            \the\last &&\\\hline
        \end{tabularx}%
        \normalsize
    }{}%
}

% ==============================================================================
% 8. Exercise Environment (Aufgabe) & Layout Settings
% ==============================================================================

\newlength{\FirstColWidth}
\setlength{\FirstColWidth}{2mm}
\newlength{\LastColWidth}
\setlength{\LastColWidth}{15mm}
\newlength{\MiddleColWidth}
\setlength{\MiddleColWidth}{\dimexpr\textwidth - \FirstColWidth - \LastColWidth - 5mm}

\newenvironment{Aufgabe}[2][]
{%
\begin{minipage}[t]{\textwidth}
    \neverindent 
    \gdef\TaskScore{0}% Reset task score accumulator for the new exercise
    \def\ManualScore{#1}% Store optional override
    \stepcounter{Punkte}%
    
    % Read from .aux to populate the score box
    \ifcsname AufgabeScore\thePunkte\endcsname
        \edef\Pkt{\csname AufgabeScore\thePunkte\endcsname}%
        \def\PrintPkt{\formatScore{\Pkt}}%
    \else
        \def\Pkt{0}% Fallback for internal arrays
        \def\PrintPkt{-}% UI Fallback for the very first compilation
    \fi
    % \aPunkte mapping removed (unused)
    \ifdim\pagetotal=0pt
        \def\wrapvspace{0pt}%
    \else
        \def\wrapvspace{-1.5\baselineskip}%
    \fi
    \vspace{.1mm}%
    \par\noindent
    
    % Wrapfigure floats the score box right
    \begin{wrapfigure}{r}{3cm}
        \vspace{\wrapvspace}% 
        \raggedleft
        \Large\framebox[1.1\width]{ ~~~~~ / ~\PrintPkt~}%
    \end{wrapfigure}%
    
    % Print title
    \textbf{\Large (\thePunkte) #2} \quad
    \ignorespaces \normalsize
}
{%
    \par\vspace{1ex}%
    % Determine final score: auto-calculated or manual override?
    \ifx\ManualScore\empty
        \xdef\FinalScore{\TaskScore}%
    \else
        \xdef\FinalScore{\ManualScore}%
    \fi
    
    % Write the evaluated score to the .aux file for the next run
    \immediate\write\@auxout{\string\expandafter\string\gdef\string\csname\space AufgabeScore\thePunkte\string\endcsname{\FinalScore}}%
    
    % Add current score to global exam total
    \xdef\TotalScoreG{\fpeval{\TotalScoreG + \FinalScore}}%
\end{minipage}
    \normalsize
}

