% 2. Checkmark Symbols (TikZ)
% ==============================================================================
\def\fullcheckmark{%
    \tikz\draw[scale=0.4,fill=black](0,.35) -- (.25,0) -- (1,.7) -- (.25,.15);%
}

\def\halfcheckmark{%
    \tikz\draw[scale=0.4,fill=black](0,.35) -- (.25,0) -- (1,.7) -- (.25,.15) -- cycle (0.75,0.2) -- (0.77,0.2)  -- (0.6,0.7) -- cycle;%
}

\def\quartcheckmark{%
    \tikz\draw[scale=0.4,fill=black](0,.35) -- (.25,0) -- (1,.7) -- (.25,.15) -- 
    cycle (0.65,0.1) -- (0.67,0.1)  -- (0.6,0.8) -- cycle  -- 
    cycle (0.85,0.3) -- (0.87,0.2)  -- (0.8,0.9) -- cycle;%
}

