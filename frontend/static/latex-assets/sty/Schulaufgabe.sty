    \fi}
    \rhead{
    \ifnum\thepage=1
    {
    \Datumtext \\
    Klasse \Klassetext \ (\Lehrernachnametext)}
    \else
    \fi
    }
    \chead{
    \ifnum\thepage=1
    {
    \Large
