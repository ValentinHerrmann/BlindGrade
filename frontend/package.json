{
  "name": "blindgrade-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cp -r ../backend/latex-assets static/ && node scripts/generate-latex-assets-index.js",
    "dev": "vite dev",
    "prebuild": "cp -r ../backend/latex-assets static/ && node scripts/generate-latex-assets-index.js",
    "build": "vite build && npm run process-large-files",
    "process-large-files": "node scripts/process-large-files.mjs build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "sri:verify": "node scripts/verify-sri.mjs",
    "postinstall": "npx texlyre-busytex download-assets static/core && node scripts/process-large-files.mjs static"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@sveltejs/kit": "^2.5.0",
    "argon2-browser": "^1.18.0",
    "codemirror": "^6.0.2",
    "dexie": "^4.0.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.3",
    "texlyre-busytex": "^1.2.3",
    "zxing-wasm": "^1.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/diff": "^7.0.2",
    "@types/qrcode": "^1.5.0",
    "eslint": "^9.5.0",
    "eslint-plugin-svelte": "^2.39.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.3.0",
    "svelte": "^5.56.8",
    "svelte-check": "^3.7.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  }
}
