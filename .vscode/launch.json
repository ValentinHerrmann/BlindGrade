{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Debug Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://blindgrade:blindgrade@localhost:5432/blindgrade",
        "DATABASE_URL_SYNC": "postgresql+psycopg2://blindgrade:blindgrade@localhost:5432/blindgrade",
        "REDIS_URL": "redis://localhost:6379/0",
        "SECRET_KEY": "dev-secret-key-change-me-in-production-32-chars-long!",
        "CORS_ALLOWED_ORIGINS": "[\"http://localhost:5173\"]",
        "ENVIRONMENT": "development"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Python: Debug Pytest (Backend)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${workspaceFolder}/backend/tests"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "DATABASE_URL": "sqlite+aiosqlite:///:memory:",
        "SECRET_KEY": "test-secret-key-not-for-production",
        "CORS_ALLOWED_ORIGINS": "[\"http://localhost:5173\"]",
        "ENVIRONMENT": "development"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SvelteKit: Debug Vite Frontend (Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    },
    {
      "name": "Chrome: Debug Frontend (Browser)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Vitest: Debug Frontend Tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vitest", "run"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "SvelteKit: Debug Frontend (Server + Browser)",
      "configurations": [
        "SvelteKit: Debug Vite Frontend (Server)",
        "Chrome: Debug Frontend (Browser)"
      ],
      "stopAll": true
    }
  ]
}
