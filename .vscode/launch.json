{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://blindgrade:blindgrade@localhost:5432/blindgrade",
        "DATABASE_URL_SYNC": "postgresql+psycopg2://blindgrade:blindgrade@localhost:5432/blindgrade",
        "REDIS_URL": "redis://localhost:6379/0",
        "SECRET_KEY": "dev-secret-key-change-me-in-production-32-chars-long!",
        "CORS_ALLOWED_ORIGINS": "[\"http://localhost:5173\"]",
        "ENVIRONMENT": "development"
      },
      "justMyCode": true
    },
    {
      "name": "Frontend Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Wait 1s"
    }
  ],
  "compounds": [
    {
      "name": "Debug",
      "configurations": ["Backend", "Frontend Server", "Frontend Browser"],
      "stopAll": true
    }
  ]
}